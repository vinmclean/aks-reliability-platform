# =========================
# Terraform
# =========================

# Local .terraform directories
**/.terraform/*

# Terraform state files (SENSITIVE)
*.tfstate
*.tfstate.*

# Terraform crash logs
crash.log

# Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# =========================
# Terraform Variable Files (Secrets)
# =========================

# DO NOT commit secrets
*.tfvars
*.tfvars.json

# Exception: allow example files
!*.example.tfvars

# =========================
# Sensitive environment variables
# =========================

.env
.env.*

# =========================
# OS / Editor Files
# =========================

# Mac
.DS_Store

# Windows
Thumbs.db
desktop.ini

# VS Code
.vscode/

# JetBrains IDEs
.idea/

# =========================
# Logs
# =========================

*.log

# =========================
# Optional: Ignore plan files
# =========================

*.tfplan

# =========================
# Python
# =========================
.venv/
__pycache__/
*.pyc